# ── Base de datos ──────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dulceria_charles

# ── JWT ─────────────────────────────────────────
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Servidor ────────────────────────────────────
PORT=3000

# ── CORS ────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── Correo (recuperar contraseña) ───────────────
# Necesario para que "olvidé mi contraseña" mande el correo real.
# Guía completa de cómo conseguir SMTP_PASSWORD (contraseña de
# aplicación de Gmail) en el encabezado de backend/mailer.js.
#
# OJO — no agregues SMTP_FROM aquí ni en cPanel: su valor normal
# lleva comillas y < > que rompen las variables de entorno de cPanel
# en producción (ver memoria cpanel-env-var-special-chars). mailer.js
# ya arma el remitente solo a partir de SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── WhatsApp (alertas al dueño: stock bajo/agotado, cancelaciones) ──
# Opcional — si falta cualquiera de estas 4, el WhatsApp simplemente
# no se manda y el correo de arriba sigue funcionando solo. Guía
# completa de cómo conseguirlas en el encabezado de backend/whatsapp.js.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TO=
WHATSAPP_LANG=es_MX

# ── Respaldo de base de datos (backend/scripts/backupDB.js) ─────
# Opcional — a qué correo llega la copia diaria del respaldo. Si se
# deja vacío, usa SMTP_USER (la misma cuenta que manda todo lo demás).
# Solo tiene sentido tocarla si algún día se quiere mandar el
# respaldo a una cuenta distinta a la del dueño.
BACKUP_EMAIL=

# Contraseña con la que se cifra el .sql.gz ANTES de mandarlo por
# correo (contiene datos reales de clientes — nombres, direcciones,
# teléfonos, historial de compra — nunca debe viajar sin cifrar).
# Si se deja vacía, el script NO manda el correo (solo guarda la
# copia local, que ya está protegida por los permisos del server).
# Genera una segura con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
# Guárdala en un gestor de contraseñas — hace falta para restaurar
# el respaldo si algún día se necesita, y NO se puede recuperar del
# correo ni del .env de producción si se pierde.
BACKUP_ENCRYPTION_PASSWORD=
